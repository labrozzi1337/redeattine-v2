{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        { "source": "/admin/(.*)", "destination": "/admin/index.html" },
        { "source": "/((?!assets/|admin/).*)", "destination": "/index.html" }
      ]
    },
    "server": {
      "root": "server",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/sitemap.xml", "destination": { "service": "server", "path": "/api/sitemap" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
