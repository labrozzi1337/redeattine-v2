{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://attini-site-api.vercel.app/api/:path*" },
    { "source": "/sitemap.xml", "destination": "https://attini-site-api.vercel.app/api/sitemap" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/((?!assets/|admin/).*)", "destination": "/index.html" }
  ]
}
