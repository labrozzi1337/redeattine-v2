# Back-end (Next.js). Copie para server/.env.local em desenvolvimento; em produção, cadastre na Vercel.

# Postgres do Supabase (Project Settings > Database > Connection string).
# Na Vercel use o "Transaction pooler" (porta 6543). Para rodar db:migrate, a "Direct connection" ou o "Session pooler".
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Storage do Supabase (imagens do blog, bucket "site-attini"). A chave secreta fica SÓ aqui, nunca no front.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Assina o cookie de login. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Endereço público do site (links de convite, sitemap e origem permitida)
SITE_URL=https://www.redeattini.com.br
# Outras origens que podem usar a API, separadas por vírgula (ex.: domínio de teste da Vercel)
ALLOWED_ORIGINS=

# Opcional: e-mail para convites e "esqueci a senha". Sem isso, o painel mostra o link para copiar.
SMTP_URL=
MAIL_FROM=Rede Attini <nao-responda@redeattini.com.br>
