# Back-end (Next.js). Copie para server/.env.local; em produção, cadastre na Vercel.
# O banco é acessado pela API do Supabase com a chave secreta: não precisa da senha do banco.
# Pré-requisitos no Supabase: rodar server/db/001, 002 e 003 no SQL Editor e expor o schema
# SYS_SITE_ATTINI em Project Settings > Data API > Exposed schemas.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta (sb_secret_...). Fica SÓ no back-end, nunca no front e nunca com prefixo VITE_.
SUPABASE_SECRET_KEY=

# Assina o cookie de login. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Endereço público do site (links de convite, sitemap e origem permitida)
SITE_URL=https://www.redeattini.com.br
# Outras origens que podem usar a API, separadas por vírgula (ex.: http://localhost:5173 em desenvolvimento)
ALLOWED_ORIGINS=

# Opcional: e-mail para convites e "esqueci a senha". Sem isso, o painel mostra o link para copiar.
SMTP_URL=
MAIL_FROM=Rede Attini <nao-responda@redeattini.com.br>
